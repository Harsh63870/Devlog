# Path to the git repository DevLog operates on (host path, mounted into backend at /repo)
REPO_PATH=.

# GitHub personal access token — required for push & PR creation
# Scopes: repo (private repos) or public_repo (public repos only)
GITHUB_TOKEN=

# Default base branch for pull requests
DEFAULT_BASE_BRANCH=main

# API URL baked into the frontend build (browser-accessible backend URL)
VITE_API_URL=http://localhost:8000

# Host ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
